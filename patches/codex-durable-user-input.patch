+    /// Append User messages while the caller holds an active tool response.
+    /// No queued copy is created, so compaction and restart see the same history.
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "exact active turn validation and history append must remain atomic"
+    )]
+    pub(crate) async fn persist_user_items_to_active_turn(
+        &self,
+        expected_turn_id: &str,
+        items: &[ResponseItem],
+    ) -> codex_protocol::error::Result<()> {
+        use codex_protocol::error::CodexErr;
+        use codex_protocol::models::ContentItem;
+        if items.is_empty() || items.iter().any(|item| !matches!(item,
+            ResponseItem::Message { role, content, .. } if role == "user"
+                && !content.is_empty() && content.iter().all(|part| matches!(part, ContentItem::InputText { .. })))) {
+            return Err(CodexErr::InvalidRequest("durable active input requires non-empty User text messages".to_owned()));
+        }
+        let active = self.active_turn.lock().await;
+        let task = active
+            .as_ref()
+            .and_then(|turn| turn.task.as_ref())
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("no active turn for durable input".to_owned())
+            })?;
+        if task.turn_context.sub_id != expected_turn_id
+            || task.kind != crate::state::TaskKind::Regular
+        {
+            return Err(CodexErr::InvalidRequest(
+                "durable input does not match the active regular turn".to_owned(),
+            ));
+        }
+        self.record_conversation_items(task.turn_context.as_ref(), items)
+            .await;
+        self.flush_rollout().await
+    }
+
