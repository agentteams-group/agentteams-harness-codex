@@ -0,0 +1,112 @@
+//! Optional trusted-host admission at the actual native model boundary.
+//! No model arguments can select the executable or its native scope.
+use std::process::Stdio;
+use std::sync::Arc;
+use std::time::Duration;
+
+use codex_protocol::error::{CodexErr, Result};
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::{ContentItem, ResponseItem};
+use serde_json::{Value, json};
+use tokio::io::AsyncWriteExt;
+
+use crate::context::{ContextualUserFragment, HookAdditionalContext};
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+
+tokio::task_local! { pub(crate) static MODEL_ADMITTED: (); }
+
+pub(crate) async fn invoke(request: Value) -> Result<Value> {
+    let Ok(command) = std::env::var("CODEX_NATIVE_ADMISSION_COMMAND") else {
+        return Ok(json!({"ok":true,"receipts":[]}));
+    };
+    let failed =
+        || CodexErr::InvalidRequest("Native framework admission requires verification".to_owned());
+    let argv: Vec<String> = serde_json::from_str(&command).map_err(|_| failed())?;
+    let (program, args) = argv.split_first().ok_or_else(failed)?;
+    let mut child = tokio::process::Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|_| failed())?;
+    let mut input = child.stdin.take().ok_or_else(failed)?;
+    input
+        .write_all(request.to_string().as_bytes())
+        .await
+        .map_err(|_| failed())?;
+    drop(input);
+    let output = tokio::time::timeout(Duration::from_secs(30), child.wait_with_output())
+        .await
+        .map_err(|_| failed())?
+        .map_err(|_| failed())?;
+    if !output.status.success() || output.stdout.len() > 1024 * 1024 {
+        return Err(failed());
+    }
+    let reply: Value = serde_json::from_slice(&output.stdout).map_err(|_| failed())?;
+    if reply["ok"] != true {
+        return Err(failed());
+    }
+    Ok(reply)
+}
+
+pub(crate) async fn prepare(
+    sess: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+) -> Result<Option<String>> {
+    let reply =
+        invoke(json!({"mode":"prepare","threadId":sess.thread_id,"turnId":turn.sub_id})).await?;
+    let receipts = reply["receipts"].as_array().cloned().unwrap_or_default();
+    if receipts.len() > 50 {
+        return Err(CodexErr::InvalidRequest(
+            "Too many framework receipt fragments".to_owned(),
+        ));
+    }
+    let mut acknowledgements = Vec::new();
+    for receipt in receipts {
+        let id = receipt["receiptId"].as_str().ok_or_else(|| {
+            CodexErr::InvalidRequest("Invalid native receipt identity".to_owned())
+        })?;
+        let fact = receipt["fact"]
+            .as_str()
+            .filter(|fact| fact.len() <= 8192)
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("Invalid native receipt fragment".to_owned())
+            })?;
+        let item: ResponseItem = ContextualUserFragment::into(HookAdditionalContext::new(fact));
+        sess.record_conversation_items(turn, std::slice::from_ref(&item))
+            .await;
+        acknowledgements.push(json!({"receiptId":id,"item":item}));
+    }
+    if !acknowledgements.is_empty() {
+        sess.flush_rollout().await?;
+        invoke(json!({"mode":"ack","threadId":sess.thread_id,"turnId":turn.sub_id,"receipts":acknowledgements})).await?;
+    }
+    let Some(fact) = reply["complete"].as_str() else {
+        return Ok(None);
+    };
+    if fact.len() > 8192 {
+        return Err(CodexErr::InvalidRequest(
+            "Invalid native completion receipt".to_owned(),
+        ));
+    }
+    let item = ResponseItem::Message {
+        id: Some(uuid::Uuid::new_v4().to_string()),
+        role: "assistant".to_owned(),
+        content: vec![ContentItem::OutputText {
+            text: fact.to_owned(),
+        }],
+        phase: Some(MessagePhase::FinalAnswer),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    if let Some(native) = crate::event_mapping::parse_turn_item(&item) {
+        sess.emit_turn_item_started(turn, &native).await;
+        sess.record_conversation_items(turn, std::slice::from_ref(&item))
+            .await;
+        sess.emit_turn_item_completed(turn, native).await;
+    }
+    sess.flush_rollout().await?;
+    Ok(Some(fact.to_owned()))
+}
