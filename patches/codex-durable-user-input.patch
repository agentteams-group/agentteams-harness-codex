+#[tokio::test]
+async fn durable_active_user_input_enters_history_without_a_queued_copy() {
+    let (sess, tc, _rx) = make_session_and_context_with_rx().await;
+    sess.spawn_task(
+        Arc::clone(&tc),
+        Vec::new(),
+        NeverEndingTask {
+            kind: TaskKind::Regular,
+            listen_to_cancellation_token: true,
+        },
+    )
+    .await;
+    let item = ResponseItem::Message {
+        id: None,
+        role: "user".to_string(),
+        content: vec![ContentItem::InputText {
+            text: "durable source fixture".to_string(),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    assert!(
+        sess.persist_user_items_to_active_turn("wrong-turn", std::slice::from_ref(&item))
+            .await
+            .is_err()
+    );
+    assert!(
+        !sess
+            .state
+            .lock()
+            .await
+            .clone_history()
+            .raw_items()
+            .contains(&item)
+    );
+    sess.persist_user_items_to_active_turn(&tc.sub_id, std::slice::from_ref(&item))
+        .await
+        .unwrap();
+    assert!(
+        sess.state
+            .lock()
+            .await
+            .clone_history()
+            .raw_items()
+            .contains(&item)
+    );
+    assert!(!sess.input_queue.has_pending_input(&sess.active_turn).await);
+    sess.abort_all_tasks(TurnAbortReason::Interrupted).await;
+}
+
+#[tokio::test]
+async fn durable_active_input_rejects_assistant_items() {
+    let (sess, _tc, _rx) = make_session_and_context_with_rx().await;
+    let item = ResponseItem::Message {
+        id: None,
+        role: "assistant".to_string(),
+        content: vec![ContentItem::OutputText {
+            text: "not a User input".to_string(),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    assert!(
+        sess.persist_user_items_to_active_turn("turn", &[item])
+            .await
+            .is_err()
+    );
+}
