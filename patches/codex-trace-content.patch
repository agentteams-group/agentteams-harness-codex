diff --git a/codex-rs/core/src/native_trace_content.rs b/codex-rs/core/src/native_trace_content.rs
new file mode 100644
index 0000000..b571e31
--- /dev/null
+++ b/codex-rs/core/src/native_trace_content.rs
@@ -0,0 +1,66 @@
+//! Capture native request/tool payloads under the shared content policy.
+use regex_lite::Regex;
+use serde_json::Value;
+use std::sync::LazyLock;
+
+static SECRET_KEY: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"(?i)api[_-]?key|secret|password|authorization|access[_-]?token|gateway[_-]?key|credential|license[_-]?key|security[_-]?token|OTEL_EXPORTER_OTLP(?:_TRACES)?_HEADERS").expect("valid credential field pattern")
+});
+static BEARER: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r#"(?i)Bearer\s+[^\s\"',]+"#).expect("valid bearer pattern"));
+
+pub(crate) fn content(value: Value) -> String {
+    let credentials: Vec<String> = std::env::vars()
+        .filter(|(key, value)| SECRET_KEY.is_match(key) && value.len() >= 8)
+        .map(|(_, value)| value)
+        .collect();
+    serde_json::to_string(&sanitize(value, &credentials)).unwrap_or_default()
+}
+
+fn sanitize(value: Value, credentials: &[String]) -> Value {
+    match value {
+        Value::Object(fields) => Value::Object(
+            fields
+                .into_iter()
+                .map(|(key, value)| {
+                    let value = if SECRET_KEY.is_match(&key) {
+                        Value::String("[REDACTED]".into())
+                    } else {
+                        sanitize(value, credentials)
+                    };
+                    (key, value)
+                })
+                .collect(),
+        ),
+        Value::Array(values) => Value::Array(
+            values
+                .into_iter()
+                .map(|v| sanitize(v, credentials))
+                .collect(),
+        ),
+        Value::String(mut text) => {
+            for credential in credentials {
+                text = text.replace(credential, "[REDACTED]");
+            }
+            Value::String(BEARER.replace_all(&text, "Bearer [REDACTED]").into_owned())
+        }
+        other => other,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn keeps_returned_reasoning_and_redacts_credentials_without_mutating_input() {
+        let original = json!({"content": [{"type":"reasoning", "text":"returned reasoning"}],
+                             "password":"private-value", "output":"known-credential Bearer opaque-token"});
+        let clean = sanitize(original.clone(), &["known-credential".into()]);
+        assert_eq!(clean["content"], original["content"]);
+        assert_eq!(clean["password"], "[REDACTED]");
+        assert_eq!(clean["output"], "[REDACTED] Bearer [REDACTED]");
+        assert_eq!(original["password"], "private-value");
+    }
+}
